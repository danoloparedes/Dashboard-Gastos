# El dashboard desplegado en Vercel usa /api del mismo proyecto.
# Solo define esta variable si en el futuro mueves la API de datos a otro dominio.
# VITE_DATA_API_URL=https://api.example.com/api

# Voz incluida en /api/voice del mismo proyecto: no necesita VITE_VOICE_API_URL.
# Configurar estas variables en Vercel (solo servidor).
# Para el backend Python local, usar backend/.env.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_EXPENSE_MODEL=gpt-4o-mini
